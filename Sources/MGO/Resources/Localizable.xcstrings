    "proposition.statement_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gegevens worden **beveiligd** en via een **veilige verbinding** opgehaald."
          }
        }
      }
    },
    "proposition.statement_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gegevens komen direct van de zorgaanbieder die je kiest. **Alleen jij hebt toegang.**"
          }
        }
      }
    },
    "proposition.statement_3" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Je kiest zelf** hoe je je gegevens wilt gebruiken en of je ze deelt met anderen."
          }
        }
      }
    },
    "proposition.statement_4" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt de gegevens in je overzicht altijd **verwijderen of opnieuw ophalen**."
          }
        }
      }
    },
    "proposition.subheading" : {
      "extractionState" : "manual",
      "localizations" : {
