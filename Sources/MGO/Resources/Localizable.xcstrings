          "stringUnit" : {
            "state" : "translated",
            "value" : "Mijn\nGezondheids\nOverzicht"
          }
        }
      }
    },
    "launch_loading" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aan het laden"
          }
        }
      }
    },
    "onboarding_action" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volgende"
          }
        }
      }
    },
    "onboarding_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inzien wat je huisarts, ziekenhuis en andere zorgverleners weten over jou. Alles in één overzicht. Veilig en overzichtelijk.\n\nMijn Zorg is een eenvoudige versie van een Persoonlijke Gezondheidsomgeving (PGO). "
          }
        }
      }
    },
    "onboarding_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jouw gezondheidsgegevens op één plek verzameld"
          }
        }
      }
    },
    "previous" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorige"
          }
        }
      }
    },
    "privacy_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In de %@ staat hoe Mijn Zorg jouw gegevens gebruikt. Dit zijn de belangrijkste punten:"
          }
        }
      }
    },
    "privacy_item_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gegevens worden **versleuteld** en via een **veilige** verbinding opgehaald."
          }
        }
      }
    },
    "privacy_item_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mijn Zorg haalt je gegevens rechtstreeks op bij de zorgverleners die jij selecteert. **Niemand anders dan jijzelf verwerkt je gegevens of krijgt ze te zien.**"
          }
        }
      }
    },
    "privacy_item_3" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Je kiest zelf** hoe je je gegevens wilt gebruiken en of je ze wel of niet deelt met anderen."
          }
        }
      }
    },
    "privacy_item_4" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt het overzicht altijd **eenvoudig weggooien of opnieuw opvragen.**"
          }
        }
      }
    },
    "privacy_statement" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "privacyverklaring"
          }
        }
      }
    },
    "privacy_statement_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze verklaring beschrijft in het kort het volgende:\n\n1. Wie verantwoordelijk is voor de verwerking van persoonsgegevens voor Mijn Zorg.\n2. Waarom persoonsgegevens worden verwerkt.\n3. Wat de grondslag is voor het verwerken van persoonsgegevens.\n4. Welke persoonsgegevens van de gebruiker van Mijn Zorg worden verwerkt.\n5. Hoe wordt omgegaan met cookies en statistische informatie.\n6. Aan wie de persoonsgegevens verstrekt kunnen worden.\n7. Welke bewaartermijnen gelden.\n8. Wat de rechten zijn van de gebruiker.\n9. Welke beveiligingsmaatregelen genomen zijn.\n10. Dat de privacyverklaring gewijzigd kan worden.\n11. In het Besluit verwerking persoonsgegevens generieke digitale infrastructuur wordt de verwerking van persoonsgegevens uitvoerig beschreven (vindplaats: Staatsblad 2016, 195)"
          }
        }
      }
    },
    "privacy_statement_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacyverklaring Mijn Zorg"
          }
        }
      }
    },
    "privacy_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zo gebruikt Mijn Zorg jouw gegevens"
          }
        }
      }
    }
  },
  "version" : "1.0"
}