    "proposition.statement_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gegevens worden **versleuteld** en via een **veilige** verbinding opgehaald."
          }
        }
      }
    },
    "proposition.statement_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De website haalt je gegevens direct op bij de zorgverleners die jij kiest. **Alleen jij hebt toegang.**"
          }
        }
      }
    },
    "proposition.statement_3" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Je kiest zelf** hoe je je gegevens wilt gebruiken en of je ze wel of niet deelt met anderen."
          }
        }
      }
    },
    "proposition.statement_4" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt de gegevens in je overzicht **altijd verwijderen of opnieuw opvragen.**"
          }
        }
      }
    },
    "proposition.subheading" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In de [%@](privacyverklaring) staat hoe Mijn Gezondheidsoverzicht jouw gegevens gebruikt. Dit zijn de belangrijkste punten:"
          }
        }
      }
    },
