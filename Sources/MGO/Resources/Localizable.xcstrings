    "proposition.heading" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe de app omgaat met uw gegevens"
          }
        }
      }
    },
    "proposition.statement_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw gegevens worden **beveiligd** en via een **veilige verbinding** opgehaald."
          }
        }
      }
    },
    "proposition.statement_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw gegevens komen direct van de zorgaanbieder die u kiest. **Alleen u heeft toegang.**"
          }
        }
      }
    },
    "proposition.statement_3" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**U kiest zelf** hoe u uw gegevens wilt gebruiken en of u ze deelt met anderen."
          }
        }
      }
    },
    "proposition.statement_4" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U kunt de gegevens in uw overzicht altijd **verwijderen of opnieuw ophalen**."
          }
        }
      }
    },
    "proposition.subheading" : {
